# ==========================================
# CAG ERP Environment Configuration (Example)
# Copy this file to .env and fill in your values
# ==========================================

# Database Settings
DB_HOSTNAME=localhost
DB_USERNAME=your_database_username
DB_PASSWORD="your_database_password"
DB_DATABASE=your_database_name

# Webhook Secrets
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Paymongo API Keys
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key
PAYMONGO_SECRET_KEY=your_paymongo_secret_key

# Atom Payment Settings
ATOM_LOGIN=your_atom_login
ATOM_PASSWORD=your_atom_password
ATOM_REQ_HASH_KEY=your_atom_req_hash_key
ATOM_RESP_HASH_KEY=your_atom_resp_hash_key
ATOM_REQ_ENC_KEY=your_atom_req_enc_key
ATOM_RESP_DEC_KEY=your_atom_resp_dec_key

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_firebase_server_key

# Yandex Translate API Key
YANDEX_TRANSLATE_API_KEY=your_yandex_translate_api_key

# Mpesa Settings
MPESA_SHORTCODE=your_shortcode
MPESA_HEADOFFICE=your_headoffice
MPESA_KEY=your_mpesa_key
MPESA_SECRET=your_mpesa_secret
MPESA_PASSKEY=your_mpesa_passkey
